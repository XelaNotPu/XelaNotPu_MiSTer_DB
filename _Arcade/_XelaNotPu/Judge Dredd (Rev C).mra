<misterromdescription>
	<name>Judge Dredd (Rev C Dec. 17 1997)</name>
	<setname>jdredd</setname>
	<year>1996</year>
	<manufacturer>Acclaim</manufacturer>
	<category>Shooter</category>
	<players>2</players>
	<joystick>Lightgun</joystick>
	<rotation>horizontal</rotation>
	<region>USA</region>
	<rbf>Arcade-XNZN1AcclaimGun_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- Acclaim ZN-1 (COH-1000A) light-gun core ZN1AcclaimGun. The game lives on an ATA hard
	     disk: convert MAME's disk image games/mame/jdredd/jdreddc.chd once with
	     Scripts > zn_hdd_convert (or "chdman extracthd -i jdreddc.chd -o jdreddc.img"); the core
	     mounts jdreddc.img (about 1 GB) from the <file> line below. The disk is only read.
	     Sound: PSX SPU only (no sound board on this game). Two light guns: USB light guns (Sinden, GUN4IR,
	     OpenFIRE, Blamcon, ...) or analog sticks of players 1 and 2 (F10 calibrates a USB light
	     gun), or a mouse (OSD Light Guns > Mouse as gun); Trigger, Super, and Reload (= shot off
	     the screen). Camera guns of the Sinden type need OSD Light Guns > Gun border (a white
	     frame around the picture). Original-style guns with a light sensor: OSD Gun sensors =
	     User port (SNAC), on a CRT. The game's own gun calibration is in its setup menu
	     (Service Menu > Diagnostics > Test/Calibrate guns). -->

	<!-- BIOS: Acclaim ZN-1 BIOS (coh1000a), 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1000a.zip" md5="none">
		<part name="m534002c-15.ic353" crc="8d8d0764"/>
	</rom>

	<!-- Platform: Acclaim (0x06), ioctl_index 1 -->
	<rom index="1">
		<part>06</part>
	</rom>

	<!-- Boot ROM, ioctl_index 3: MAME "bankedroms" 2 MB region, u35/u36 16-bit interleaved
	     (256 KB), the rest 0x00 as in MAME. CPU 0x1F000000 (bank register left at 0). The two
	     revisions use the same EPROM data (same CRCs); only the disk differs. -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="jdredd.zip" md5="none">
		<interleave output="16">
			<part name="79d3_01-16-98_1565_u_35.u35" crc="c1e17191" map="01"/>
			<part name="9e54_01-16-98_1566_u_36.u36" crc="37addbf9" map="10"/>
		</interleave>
	</rom>
	<rom index="13"><part>00 00 1C 00</part></rom>  <!-- gap: 0x1C0000 bytes of 00, cleared by the core -->

	<!-- CAT702 key A: motherboard key (ac01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000a.zip" md5="none">
		<part name="ac01.ic652" crc="c425eaf5"/>
	</rom>

	<!-- CAT702 key B: game key (ac02), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="jdredd.zip" md5="none">
		<part name="ac02" crc="1412d475"/>
	</rom>

	<!-- Hard disk (MAME "jdreddc", SHA1 eee205f83e5f590f8baf36452c873d7063156bd0): raw image in image slot 0 -->
	<file delay="0" type="s" index="0" root="games" path="mame/jdredd/jdreddc.img"/>

	<!-- NVRAM, ioctl_index 9: the AT28C16 EEPROM (2 KB): settings, gun calibration, high scores.
	     On first start the game reports "PROBLEM WITH NVRAM": press Start to restore defaults. -->
	<nvram index="9" size="2048"/>

	<!-- ZN board DSW S551 is read by the BIOS through the ZNMCU. Switch 2 On starts the Sony
	     BIOS "TEST MODE" screen instead of the game; MAME leaves 1/3/4 unnamed. The game's own
	     setup menu is the OSD "Service Menu" switch or the mapped Test button. -->
	<switches default="00">
		<dip bits="1" name="BIOS Test Mode" ids="Off,On"/>
	</switches>

	<buttons names="Trigger,Super,Reload,-,-,-,Start,Coin,Pause,Service,Test" default="A,B,X,Y,R,L,Start,Select" count="3"/>
</misterromdescription>
