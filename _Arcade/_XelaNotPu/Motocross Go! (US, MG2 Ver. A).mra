<misterromdescription>
	<!-- SYSTEM23 rbf: supported (ASCA-3A + V183 AMC JVS personality, cfg byte 1 = 7; rtl/h8/s23_jvs_node.vhd amc, SYSTEM23.sv s23_mgin, docs/motogo.md); boots to full 3D attract on hardware (tag motogo-hw-20261022). The AMC MCU ROM (exioboard) is not streamed: the core answers the AMC's JVS replies itself (captured from MAME 0.287); the motion base does not move. Point ROM: MAME region 16 MB, the 16-24 MB slot pad reads 0xFF as MAME's over-limit reads do.
	     Status table: docs/mra_library.md -->
	<name>Motocross Go! (US, MG2 Ver. A)</name>
	<setname>motoxgov2a</setname>
	<rbf>Arcade-XNSYSTEM23_20261107</rbf>
	<mraauthor>XelaNotPu</mraauthor>
	<about author="xelanotpu" webpage="https://www.patreon.com/XelaNotPu" />
	<mameversion>0287</mameversion>
	<year>1997</year>
	<manufacturer>Namco</manufacturer>
	<category>Racing / Motorcycle</category>
	<platform>Namco System 23</platform>
	<rotation>horizontal</rotation>
	<region>USA</region>

	<!-- J1 bits 4..12 (SYSTEM23.sv s23_mgin, docs/motogo.md; MAME motoxgo namcos23.cpp:7308): Throttle / Brake buttons ramp
	     ch 1 / ch 2 (OSD rate), View -> JVS bit 0, Start -> bit 1; left stick X / wheel = Steering (ch 0), right stick X = Bank
	     (ch 3), analog pedals per OSD; D-pad / 8-way stick L/R ramps Steering + Bank together (docs/controls_8way.md);
	     stick up/down = Select Up/Down; Pause -->
	<buttons names="Throttle,Brake,View,Start,Coin,Service,Test,-,Pause" default="A,B,X,Start,Select,-,-,-,-"/>

	<!--
	  Download stream, layout S23 (tools/s23_mra.py LAYOUTS, docs/mra_library.md), length 0x7280000.
	  Every slot is the MAME region image, padded to the slot with the region fill (0x00, or 0xFF for ROMREGION_ERASEFF):
	    stream 0x0000000   4.00M user1        -> SDRAM 0x0400000
	    stream 0x0400000   0.50M subcpu       -> SDRAM 0x0800000
	    stream 0x0480000  32.00M data         -> SDRAM 0x1000000
	    stream 0x2480000  16.00M c352         -> SDRAM 0x3000000
	    stream 0x3480000  32.00M textile      -> SDRAM 0x4000000
	    stream 0x5480000  24.00M pointrom     -> SDRAM 0x6000000  (MAME region 16 MB, rest 0xFF)
	    stream 0x6C80000   4.00M textilemapl  -> SDRAM 0x7800000
	    stream 0x7080000   2.00M textilemaph  -> SDRAM 0x7C00000
	    stream 0x7280000        end
	  Verify offline: tools/s23_mra.py "mra/Motocross Go! (US, MG2 Ver. A).mra"
	-->
	<rom index="0" zip="motoxgov2a.zip|motoxgo.zip" md5="None">
		<!-- user1: ROM_LOAD16_BYTE -->
		<interleave output="16">
			<part name="mg2vera.ic2" crc="66093336" map="01"/>
			<part name="mg2vera.ic1" crc="3dc7736f" map="10"/>
		</interleave>
		<!-- subcpu: ROM_LOAD16_WORD_SWAP -->
		<interleave output="16">
			<part name="mg3vera.ic3" crc="9e3d46a8" map="12"/>
		</interleave>
		<!-- data: ROM_LOAD16_BYTE (ROMREGION_ERASEFF) -->
		<interleave output="16">
			<part name="mg1mtah.2j" crc="845f4768" map="01"/>
			<part name="mg1mtal.2h" crc="fdad0f0a" map="10"/>
		</interleave>
		<!-- data 0x1000000-0x1FFFFFF: 0xFF (MAME ROMREGION_ERASEFF fill) -->
		<part repeat="0x40000">FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF</part>
		<!-- c352: ROM_LOAD (ROMREGION_ERASEFF) -->
		<part name="mg1wavel.2c" crc="f78b1b4d"/>
		<part name="mg1waveh.2a" crc="8cb73877"/>
		<!-- textile: ROM_LOAD (ROMREGION_ERASEFF) -->
		<part name="mg1cgll.5m" crc="175dfe34"/>
		<part name="mg1cglm.5k" crc="b3e648e7"/>
		<part name="mg1cgum.5j" crc="46a77d73"/>
		<!-- textile 0x1800000-0x1FFFFFF: 0xFF (MAME ROMREGION_ERASEFF fill) -->
		<part repeat="0x20000">FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF</part>
		<!-- pointrom: ROM_LOAD32_WORD_SWAP (ROMREGION_ERASEFF) -->
		<interleave output="32">
			<part name="mg1pt0h.7a" crc="c9ba1b47" map="0012"/>
			<part name="mg1pt0l.7c" crc="3b9e95d3" map="1200"/>
		</interleave>
		<interleave output="32">
			<part name="mg1pt1h.5a" crc="8d4f7097" map="0012"/>
			<part name="mg1pt1l.5c" crc="0dd2f358" map="1200"/>
		</interleave>
		<!-- pointrom 0x1000000-0x17FFFFF: 0xFF (MAME ROMREGION_ERASEFF fill) -->
		<part repeat="0x20000">FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF</part>
		<!-- textilemapl: ROM_LOAD -->
		<part name="mg1ccrl.7m" crc="5372e300"/>
		<!-- textilemaph: ROM_LOAD -->
		<part name="mg1ccrh.7k" crc="2e77597d"/>
	</rom>

	<!-- per-game platform config (rtl/s23/s23_core.vhd cfg_*, docs/mra_library.md): byte 0 = 0x02
	     (decoded: bit0 SS23 map, bit1 ASCA-3A JVS, bit2 2 MB textilemapl, bit7 start in 480i; markers, not decoded:
	     bit3 Gorgon, bit4 GMEN, bit5 Evolution 2 (the SUPER23 rbf selects it), bit6 S23PT32 layout);
	     byte 1 = I/O personality 7 = ASCA-3A + AMC;
	     byte 2 bits 1:0 = 2: start in 240p (the "(240p)" copies, tools/mra_480i.py) -->
	<rom index="1"><part>02 07</part></rom>

	<!-- backup RAM (64 KB): LAST, so a saved .nvm (sent at this tag) overrides any default above. Release staging
	     (tools/build_release.sh) appends the pause / credits canvas (MRA index 9, DDR3 address 0x30C00000) after
	     this tag; the repo MRAs carry no index-9 block (the core shows the pause screen only when it was loaded). -->
	<nvram index="4" size="65536"/>

	<!-- index 9: PATREON pause screen (credits) -->
	<!-- B_PAUSEIMG: PATREON pause screen, 640x640 RGB565 little-endian scrolling credits canvas (tools/gen_pause_image.py
	     from pause_src/pause.txt, no ROM data); Main_MiSTer writes it into DDR3 at 0x30C00000, the core scrolls it
	     while paused (rtl/s23/s23_r3d_scan.sv PBASE, SYSTEM23.sv s23_pausevid). -->
