<misterromdescription>
	<name>Primal Rage II (Test Version 0.36a)</name>
	<setname>primrag2</setname>
	<year>1997</year>
	<manufacturer>Atari</manufacturer>
	<category>Fighting</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>USA</region>
	<rbf>Arcade-XNZN1TWarner_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

<!-- Time Warner ZN-1 (COH-1000W) with the Atari game board: VT83C461 IDE controller and a
	     hard disk. Core ZN1TWarner. The game lives on the disk: convert MAME's disk image
	     games/mame/primrag2/primrag2.chd once with Scripts > zn_hdd_convert (or
	     "chdman extracthd -i primrag2.chd -o primrag2.img"); the core mounts primrag2.img
	     (1,081,737,216 bytes) from the <file> line below. The disk is only read.
	     Sound: PSX SPU only. Six buttons per player (MAME INPUT_PORTS primrag2). -->

	<!-- BIOS: Time Warner / Atari ZN-1 BIOS (coh1000w), 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1000w.zip" md5="none">
		<part name="msm27c402zb.ic353" crc="45e8a4b4"/>
	</rom>

	<!-- Platform: Time Warner / Primal Rage II (0x08), ioctl_index 1 -->
	<rom index="1">
		<part>08</part>
	</rom>

	<!-- Program ROMs: region 0x200000 (2MB), MAME region "roms", two 16-bit interleaved  -->
	<!-- pairs (u14/u16 at 0x000000, u15/u17 at 0x100000), each half 512KB.               -->
	<rom index="3" zip="primrag2.zip" md5="none">
		<interleave output="16">
			<part name="pr2_036.u14" crc="c86450cd" map="01"/>
			<part name="pr2_036.u16" crc="3ee39e4f" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="pr2_036.u15" crc="4b24bd54" map="01"/>
			<part name="pr2_036.u17" crc="3681516c" map="10"/>
		</interleave>
	</rom>

	<!-- CAT702 key A: motherboard key (tw01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000w.zip" md5="none">
		<part name="tw01.ic652" crc="1cac067e"/>
	</rom>

	<!-- CAT702 key B: game key (tw02), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="primrag2.zip" md5="none">
		<part name="tw02" crc="583e8e1c"/>
	</rom>

	<!-- AT28C16 EEPROM, ioctl_index 9: the user's own file from primrag2.zip (MAME region
	     "at28c16"); a saved .nvm replaces it once the game has written its settings. -->
	<rom index="9" zip="primrag2.zip" md5="none">
		<part name="at28c16" crc="62c21283"/>
	</rom>

	<!-- Hard disk (MAME "primrag2", SHA1 bc615068ddf4fd967f770ee01c02f285c052c4c5, data SHA1
	     d79b2dad16fbdb174bcd34eb70025a53ebdb0e51): raw image in image slot 0 -->
	<file delay="0" type="s" index="0" root="games" path="mame/primrag2/primrag2.img"/>

	<nvram index="9" size="2048"/>
	<switches default="00">
		<dip name="Service Mode"  bits="1" ids="Off,On"/>
	</switches>
	<buttons names="Button 1,Button 2,Button 3,Button 4,Button 5,Button 6,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select"/>

</misterromdescription>
