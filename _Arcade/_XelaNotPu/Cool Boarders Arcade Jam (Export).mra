<misterromdescription>
	<name>Cool Boarders Arcade Jam (Export)</name>
	<setname>cbaj</setname>
	<year>1998</year>
	<manufacturer>UEP Systems</manufacturer>
	<category>Sports</category>
	<players>1</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>Export</region>
	<rbf>Arcade-XNZN1TecmoVSys_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- BIOS: Tecmo TPS System BIOS, 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1002m.zip" md5="none">
		<part name="m534002c-61.ic353" crc="69ffbcb4"/>
	</rom>

	<!-- Platform: Tecmo (0x04) + bit6 = Cool Boarders Z80/YMZ280B sound board (0x44), ioctl_index 1 -->
	<rom index="1">
		<part>44</part>
	</rom>

	<!-- Banked ROM: 5 banks x 8MB = 40MB, ioctl_index 3 (MAME region "bankedroms").      -->
	<!-- Bank 0: 1MB interleaved program (cbaj_2/cbaj_1) + 3MB empty + cb-00 (4MB)         -->
	<!-- cb-00.216 sits at region ofs 0x400000; cb-01..cb-08 follow contiguously to 40MB.  -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="cbaj.zip" md5="none">
		<interleave output="16">
			<part name="cbaj_2.120" crc="89286229" map="01"/>
			<part name="cbaj_1.119" crc="814f8b4b" map="10"/>
		</interleave>
	</rom>
	<rom index="13"><part>00 00 30 00</part></rom>  <!-- gap: 0x300000 bytes of 00, cleared by the core -->
	<rom index="3" zip="cbaj.zip" md5="none">
		<part name="cb-00.216" crc="3db68bea"/>
		<part name="cb-01.217" crc="481040bc"/>
		<part name="cb-02.218" crc="858f116c"/>
		<part name="cb-03.219" crc="3576ea2a"/>
		<part name="cb-04.220" crc="551c4b29"/>
		<part name="cb-05.221" crc="7da453da"/>
		<part name="cb-06.222" crc="833cb18b"/>
		<part name="cb-07.223" crc="3b64ce9e"/>
		<part name="cb-08.323" crc="57cc482e"/>
	</rom>

	<!-- CAT702 key A: motherboard key (mg01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1002m.zip" md5="none">
		<part name="mg01.ic652" crc="50dc8322"/>
	</rom>

	<!-- CAT702 key B: game key (mg03), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="cbaj.zip" md5="none">
		<part name="mg03" crc="8be79633"/>
	</rom>

	<!-- Z80 sound program, ioctl_index 6 -> SDRAM 0x4800000 (the Z80 runs the first 32KB) -->
	<rom index="6" zip="cbaj.zip" md5="none">
		<part name="cbaj_z80.3118" crc="92b02ad2"/>
	</rom>

	<!-- YMZ280B sample ROM ("ymz280b" region, 8MB), ioctl_index 7 -> SDRAM 0x4000000 -->
	<rom index="7" zip="cbaj.zip" md5="none">
		<part name="cb-vo.5120" crc="afb05d6d"/>
		<part name="cb-se.5121" crc="f12b3db9"/>
	</rom>

	<nvram index="9" size="2048"/>
	<switches default="00">
		<dip name="Service Mode"  bits="1" ids="Off,On"/>
	</switches>
	<buttons names="Jump,Trick,Speed,-,-,-,Start,Coin,Pause" default="A,B,X,Y,R,L,Start,Select"/>

</misterromdescription>
