<misterromdescription>
	<name>Heaven's Gate</name>
	<setname>hvnsgate</setname>
	<year>1996</year>
	<manufacturer>Racdym / Atlus</manufacturer>
	<category>Fighter</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<rbf>Arcade-XNZN1Atlus_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- BIOS: Atlus ZN-1 BIOS, 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1001l.zip" md5="none">
		<part name="m534002c-17.ic353" crc="6721146b"/>
	</rom>

	<!-- Platform: Atlus (0x03), ioctl_index 1 -->
	<rom index="1">
		<part>03</part>
	</rom>

	<!-- Banked ROM: 3 banks x 8MB = 24MB, ioctl_index 3, CPU 0x1F000000 (8MB window), bank =  -->
	<!-- byte write 0x1FB00002 & 3. 19MB of data loaded contiguously (MAME region layout):       -->
	<!--   bank 0: [0x000000-0x7FFFFF] (interleave 1MB + athg-07 4MB + athg-08 first 3MB) -->
	<!--   bank 1: [0x800000-0xFFFFFF] (athg-08 last 1MB + athg-09 4MB + athg-10 first 3MB) -->
	<!--   bank 2: [0x1000000-0x17FFFFF] (athg-10 last 1MB + athg-11 2MB + 5MB empty) -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="hvnsgate.zip|coh1001l.zip" md5="none">
		<interleave output="16">
			<part name="athg-02b.17" crc="11bfa89b" map="01"/>
			<part name="athg-01b.18" crc="e820136f" map="10"/>
		</interleave>
		<part name="athg-07.027" crc="46411f67"/>
		<part name="athg-08.028" crc="85289345"/>
		<part name="athg-09.210" crc="19e558b5"/>
		<part name="athg-10.029" crc="748f936e"/>
		<part name="athg-11.215" crc="ac8e53bd"/>
	</rom>
	<rom index="13"><part>00 00 50 00</part></rom>  <!-- gap: 0x500000 bytes of 00, cleared by the core -->

	<!-- CAT702 key A: motherboard key (at01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1001l.zip" md5="none">
		<part name="at01.ic652" crc="181668b3"/>
	</rom>

	<!-- CAT702 key B: game key (at02), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="hvnsgate.zip" md5="none">
		<part name="at02" crc="55fe469e"/>
	</rom>

	<!-- 68000 sound program, ioctl_index 6 -> SDRAM 0x4800000 (2 x 128KB, byte k = 68000 address k).
	     MAME ROM_LOAD16_BYTE athg-03.22 @0 (even), athg-04.21 @1 (odd): map 01 = even byte (68000 D15-D8). -->
	<rom index="6" zip="hvnsgate.zip" md5="none">
		<interleave output="16">
			<part name="athg-03.22" crc="7eef7e68" map="01"/>
			<part name="athg-04.21" crc="18523e85" map="10"/>
		</interleave>
	</rom>

	<!-- YMZ280B sample ROM ("ymz280b" region, 8MB), ioctl_index 7 -> SDRAM 0x4000000.
	     The board leaves the lower 4MB unpopulated (MAME: ROM_FILL 0xff). -->
	<rom index="7" zip="hvnsgate.zip" md5="none">
		<part repeat="0x400000">FF</part>
		<part name="athg-05.4136" crc="74469a15"/>
		<part name="athg-06.4134" crc="443ade73"/>
	</rom>

	<nvram index="9" size="2048"/>
	<switches default="00">
		<dip name="Service Mode"  bits="1" ids="Off,On"/>
	</switches>
	<buttons names="Attack,Kick,Guard,-,-,-,Start,Coin,Pause" default="A,B,X,Y,R,L,Start,Select"/>

</misterromdescription>
