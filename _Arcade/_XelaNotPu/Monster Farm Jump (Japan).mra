<misterromdescription>
	<name>Monster Farm Jump (Japan)</name>
	<setname>mfjump</setname>
	<year>2001</year>
	<manufacturer>Tecmo</manufacturer>
	<category>Action</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>Japan</region>
	<rbf>Arcade-XNZN1TecmoVSys_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- BIOS: Tecmo TPS System BIOS, 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1002m.zip" md5="none">
		<part name="m534002c-61.ic353" crc="69ffbcb4"/>
	</rom>

	<!-- Platform: Tecmo (0x04), ioctl_index 1 -->
	<rom index="1">
		<part>04</part>
	</rom>

	<!-- Banked ROM: 1 bank x 8MB = 8MB, ioctl_index 3, CPU 0x1F000000 (8MB window) -->
	<!-- Bank 0: 2MB interleaved + 2MB empty + 4MB mfj.216                      -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="mfjump.zip|coh1002m.zip" md5="none">
		<interleave output="16">
			<part name="mfj-e.120" crc="86292bca" map="01"/>
			<part name="mfj-o.119" crc="0d724dc5" map="10"/>
		</interleave>
	</rom>
	<rom index="13"><part>00 00 20 00</part></rom>  <!-- gap: 0x200000 bytes of 00, cleared by the core -->
	<rom index="3" zip="mfjump.zip|coh1002m.zip" md5="none">
		<part name="mfj.216" crc="0d518dba"/>
	</rom>

	<!-- CAT702 key A: motherboard key (mg01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1002m.zip" md5="none">
		<part name="mg01.ic652" crc="50dc8322"/>
	</rom>

	<!-- CAT702 key B: game key (mg14), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="mfjump.zip" md5="none">
		<part name="mg14" crc="5fa9a8c2"/>
	</rom>

	<nvram index="9" size="2048"/>
	<switches default="00">
		<dip name="Service Mode"  bits="1" ids="Off,On"/>
	</switches>
	<buttons names="Jump,Action,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,R,L,Start,Select"/>

</misterromdescription>
