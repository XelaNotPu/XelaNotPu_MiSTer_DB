<misterromdescription>
	<name>Brave Blade (Asia)</name>
	<setname>brvbladea</setname>
	<year>2000</year>
	<manufacturer>Eighting / Raizing</manufacturer>
	<category>Shooter</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>vertical</rotation>
	<region>Asia</region>
	<rbf>Arcade-XNZN1Raizing_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- BIOS: Tecmo TPS System BIOS (used by brvblade), 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1002m.zip" md5="none">
		<part name="m534002c-61.ic353" crc="69ffbcb4"/>
	</rom>

	<!-- Platform: Raizing (0x01), ioctl_index 1 -->
	<!-- brvblade uses Tecmo BIOS hardware but Raizing banking (0x1FA10300) -->
	<rom index="1">
		<part>01</part>
	</rom>

	<!-- Banked ROM: 3 banks x 8MB = 24MB, ioctl_index 3, CPU 0x1F000000 (8MB window) -->
	<!-- Bank 0: flash0 (2MB) + flash1 (2MB) + 4MB empty                        -->
	<!-- Bank 1: rom1 (4MB) + 4MB empty                                         -->
	<!-- Bank 2: 8MB empty                                                       -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="brvbladea.zip|brvblade.zip" md5="none">
		<part name="flash0.021" crc="97e12c63"/>
		<part name="flash1.024" crc="d9d40a34"/>
	</rom>
	<rom index="13"><part>00 00 40 00</part></rom>  <!-- gap: 0x400000 bytes of 00, cleared by the core -->
	<rom index="3" zip="brvbladea.zip|brvblade.zip" md5="none">
		<part name="ra-bbl_rom1.028" crc="418535e0"/>
	</rom>
	<rom index="13"><part>00 00 40 00</part></rom>  <!-- gap: 0x400000 bytes of 00, cleared by the core -->
	<rom index="13"><part>00 00 80 00</part></rom>  <!-- gap: 0x800000 bytes of 00, cleared by the core -->

	<!-- CAT702 key A: motherboard key (mg01 from Tecmo BIOS), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1002m.zip" md5="none">
		<part name="mg01.ic652" crc="50dc8322"/>
	</rom>

	<!-- CAT702 key B: game key (mg11), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="brvbladea.zip|brvblade.zip" md5="none">
		<part name="mg11" crc="56d917de"/>
	</rom>

	<!-- 68000 sound program, ioctl_index 6 -> SDRAM 0x4400000 (2 x 512KB, byte k = 68000 address k).
	     MAME ROM_LOAD16_BYTE spu0u049 @0 (even), spu1u412 @1 (odd): map 01 = even byte (68000 D15-D8), map 10 = odd byte. -->
	<rom index="6" zip="brvbladea.zip|brvblade.zip" md5="none">
		<interleave output="16">
			<part name="spu0u049.bin" crc="c9df8ed9" map="01"/>
			<part name="spu1u412.bin" crc="6408b5b2" map="10"/>
		</interleave>
	</rom>

	<!-- YMF271 sample ROM ("ymf" region, 4MB), ioctl_index 7 -> SDRAM 0x4000000 -->
	<rom index="7" zip="brvbladea.zip|brvblade.zip" md5="none">
		<part name="ra-bbl_rom2.336" crc="cd052c02"/>
	</rom>

		<nvram index="9" size="2048"/>
		<switches default="00">
			<dip name="Service Mode"  bits="1" ids="Off,On"/>
			<dip name="Test Mode"     bits="3" ids="Off,On"/>
		</switches>
	<buttons names="Shot,Blade,Core,-,-,-,Start,Coin,Pause" default="A,B,X,Y,R,L,Start,Select"/>

</misterromdescription>
