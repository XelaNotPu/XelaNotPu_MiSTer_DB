<misterromdescription>
	<name>Ray Storm (Ver 2.05A)</name>
	<setname>raystormu</setname>
	<year>1996</year>
	<manufacturer>Taito</manufacturer>
	<category>Shooter</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>Asia</region>
	<rbf>Arcade-XNZN1TaitoFX1B_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- BIOS: Taito FX-1 BIOS, 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1000t.zip" md5="none">
		<part name="m534002c-14.ic353" crc="e3f23b6e"/>
	</rom>

	<!-- Platform: Taito FX (0x02), ioctl_index 1 -->
	<rom index="1">
		<part>02</part>
	</rom>

	<!-- Banked ROM: 2 banks x 8MB = 16MB, ioctl_index 3, CPU 0x1F000000 (8MB window) -->
	<!-- Bank 0: 1MB interleaved + 3MB empty + 4MB e24-02                       -->
	<!-- Bank 1: e24-03 (4MB) + 4MB empty                                       -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="raystormu.zip|raystormo.zip|raystorm.zip" md5="none">
		<interleave output="16">
			<part name="e24-06.3" crc="d70cdf46" map="01"/>
			<part name="e24-07.4" crc="d9002b03" map="10"/>
		</interleave>
	</rom>
	<rom index="13"><part>00 00 30 00</part></rom>  <!-- gap: 0x300000 bytes of 00, cleared by the core -->
	<rom index="3" zip="raystormu.zip|raystormo.zip|raystorm.zip" md5="none">
		<part name="e24-02.1" crc="9f70950d"/>
		<part name="e24-03.2" crc="6c1f0a5d"/>
	</rom>
	<rom index="13"><part>00 00 40 00</part></rom>  <!-- gap: 0x400000 bytes of 00, cleared by the core -->

	<!-- CAT702 key A: motherboard key (tt01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000t.zip" md5="none">
		<part name="tt01.ic652" crc="daac13e7"/>
	</rom>

	<!-- CAT702 key B: game key (tt04), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="raystormu.zip|raystormo.zip|raystorm.zip" md5="none">
		<part name="tt04" crc="013363df"/>
	</rom>


	<!-- AT28C16 operator settings / high scores. MiSTer loads <mra>.nvm at ioctl index 9
	     on launch and writes it back when the core requests an upload, so a one-time
	     FACTORY SETTING in the test menu survives a power cycle, as on a real cabinet. -->
	<nvram index="9" size="2048"/>
	<switches default="00">
		<dip name="Service Mode"  bits="1" ids="Off,On"/>
		<dip name="Test Mode"     bits="3" ids="Off,On"/>
	</switches>

	<buttons names="Shot,Lock-On Laser,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,R,L,Start,Select"/>

</misterromdescription>
