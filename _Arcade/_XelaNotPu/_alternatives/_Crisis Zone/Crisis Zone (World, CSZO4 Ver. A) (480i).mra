<misterromdescription>
	<name>Crisis Zone (World, CSZO4 Ver. A) (480i)</name>
	<setname>crszonev4a</setname>
	<rbf>Arcade-XNSUPER23_20261107</rbf>
	<mraauthor>XelaNotPu</mraauthor>
	<about author="xelanotpu" webpage="https://www.patreon.com/XelaNotPu" />
	<mameversion>0287</mameversion>
	<year>1999</year>
	<manufacturer>Namco</manufacturer>
	<category>Shooter / Gun</category>
	<platform>Namco Super System 23 Evolution 2</platform>
	<rotation>horizontal</rotation>
	<region>World</region>

	<!-- J1 bits 4..12 (SYSTEM23.sv CONF_STR J1, rtl/s23/s23_gun.sv csz, docs/csz1.md; MAME crszone INPUT_PORTS):
	     Trigger (also starts a game; the CSZ1 board has no Start bit), Enter, Hide + Reload = the foot pedal: OSD
	     "Hide + Reload button" Hold = hide (default; the game reloads while hidden) or Hold = step out;
	     Off-screen = a shot off the screen (no reload on Crisis Zone); D-pad / 8-way stick = aim when the gun axes
	     are idle (docs/controls_8way.md); Pause -->
	<buttons names="Trigger,Enter,Hide + Reload,-,Coin,Service,Test,Off-screen,Pause" default="A,B,X,-,Select,-,-,Y,-"/>

	<!--
	  Download stream, layout SUPER23 (tools/s23_mra.py LAYOUTS, docs/mra_library.md), length 0x7E80000.
	  Every slot is the MAME region image, padded to the slot with the region fill (0x00, or 0xFF for ROMREGION_ERASEFF):
	    stream 0x0000000   8.00M user1        -> SDRAM 0x3000000
	    stream 0x0800000   0.50M subcpu       -> SDRAM 0x0800000
	    stream 0x0880000  32.00M data         -> SDRAM 0x1000000
	    stream 0x2880000  16.00M c352         -> DDR3 0x31000000
	    stream 0x3880000  32.00M textile      -> SDRAM 0x4000000
	    stream 0x5880000  32.00M pointrom     -> DDR3 0x32000000
	    stream 0x7880000   4.00M textilemapl  -> SDRAM 0x3800000
	    stream 0x7C80000   2.00M textilemaph  -> SDRAM 0x3C00000
	    stream 0x7E80000        end
	  DDR3 = the SDRAM #2 image at DDR3 byte 0x31000000 + SDRAM #2 byte (SUPER23.qsf / SUPER23S.qsf S23_DDRPT,
	  rtl/s23/s23_ddrrom.vhd); a build without S23_DDRPT puts it in the secondary SDRAM (SDRAM #2) at the same offset.
	  Verify offline: tools/s23_mra.py "mra/480i/Crisis Zone (World, CSZO4 Ver. A) (480i).mra"
	-->
	<rom index="0" zip="crszonev4a.zip|crszone.zip" md5="None">
		<!-- user1: ROM_LOAD16_WORD_SWAP -->
		<interleave output="16">
			<part name="cszo4vera.ic4" crc="3755b402" map="12"/>
		</interleave>
		<!-- subcpu: ROM_LOAD16_WORD_SWAP -->
		<interleave output="16">
			<part name="cszo3verb.ic1" crc="c790743b" map="12"/>
		</interleave>
		<!-- data: ROM_LOAD16_BYTE -->
		<interleave output="16">
			<part name="csz1mtah.2j" crc="66b076ad" map="01"/>
			<part name="csz1mtal.2h" crc="38dc639a" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="csz1mtbh.2m" crc="bdec4188" map="01"/>
			<part name="csz1mtbl.2f" crc="9c8f8d7a" map="10"/>
		</interleave>
		<!-- c352: ROM_LOAD -->
		<part name="csz1wavel.2c" crc="d0d74132"/>
		<part name="csz1waveh.2a" crc="de9d14a8"/>
		<!-- textile: ROM_LOAD -->
		<part name="csz1cgll.5m" crc="0bcd41f2"/>
		<part name="csz1cglm.5k" crc="d4af93d1"/>
		<part name="csz1cgum.5j" crc="913c98b5"/>
		<part name="csz1cguu.4f" crc="e1d1bf24"/>
		<!-- pointrom: ROM_LOAD32_WORD_SWAP -->
		<interleave output="32">
			<part name="csz1pt0h.7a" crc="e82f1abb" map="0012"/>
			<part name="csz1pt0l.7c" crc="b0d66afe" map="1200"/>
		</interleave>
		<interleave output="32">
			<part name="csz1pt1h.5a" crc="e54f80ad" map="0012"/>
			<part name="csz1pt1l.5c" crc="527171c8" map="1200"/>
		</interleave>
		<interleave output="32">
			<part name="csz1pt2h.4a" crc="e295137a" map="0012"/>
			<part name="csz1pt2l.4c" crc="c87d6dbd" map="1200"/>
		</interleave>
		<interleave output="32">
			<part name="csz1pt3h.3a" crc="05f65bdf" map="0012"/>
			<part name="csz1pt3l.3c" crc="5d077c0f" map="1200"/>
		</interleave>
		<!-- textilemapl: ROM_LOAD -->
		<part name="csz1ccrl.7m" crc="1c20768d"/>
		<!-- textilemaph: ROM_LOAD -->
		<part name="csz1ccrh.7k" crc="bc2fa03c"/>
	</rom>

	<!-- per-game platform config (rtl/s23/s23_core.vhd cfg_*, docs/mra_library.md): byte 0 = 0xA1
	     (decoded: bit0 SS23 map, bit1 ASCA-3A JVS, bit2 2 MB textilemapl, bit7 start in 480i; markers, not decoded:
	     bit3 Gorgon, bit4 GMEN, bit5 Evolution 2 (the SUPER23 rbf selects it), bit6 S23PT32 layout);
	     byte 1 = I/O personality 6 = CSZ1;
	     byte 2 bits 1:0 = 2: start in 240p (the "(240p)" copies, tools/mra_480i.py) -->
	<rom index="1"><part>A1 06</part></rom>

	<!-- backup RAM (64 KB): LAST, so a saved .nvm (sent at this tag) overrides any default above. Release staging
	     (tools/build_release.sh) appends the pause / credits canvas (MRA index 9, DDR3 address 0x30C00000) after
	     this tag; the repo MRAs carry no index-9 block (the core shows the pause screen only when it was loaded). -->
	<nvram index="4" size="65536"/>

	<!-- index 9: PATREON pause screen (credits) -->
	<!-- B_PAUSEIMG: PATREON pause screen, 640x640 RGB565 little-endian scrolling credits canvas (tools/gen_pause_image.py
	     from pause_src/pause.txt, no ROM data); Main_MiSTer writes it into DDR3 at 0x30C00000, the core scrolls it
	     while paused (rtl/s23/s23_r3d_scan.sv PBASE, SYSTEM23.sv s23_pausevid). -->
	<rom index="9" address="0x30C00000">
