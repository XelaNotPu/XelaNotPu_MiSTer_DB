<misterromdescription>
	<name>G-Darius (Ver 2.01J)</name>
	<setname>gdariusj</setname>
	<year>1997</year>
	<manufacturer>Taito</manufacturer>
	<category>Shooter</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>Japan</region>
	<rbf>Arcade-XNZN1TaitoFX1B_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- BIOS: Taito FX-1 BIOS, 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1000t.zip" md5="none">
		<part name="m534002c-14.ic353" crc="e3f23b6e"/>
	</rom>

	<!-- Platform: Taito FX (0x02), ioctl_index 1 -->
	<rom index="1">
		<part>02</part>
	</rom>

	<!-- Banked ROM: 2 banks x 8MB = 16MB, ioctl_index 3, CPU 0x1F000000 (8MB window) -->
	<!-- Bank 0: 2MB interleaved + 2MB empty + 4MB e39-01                       -->
	<!-- Bank 1: e39-02 (4MB) + e39-03 (4MB)                                    -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="gdariusj.zip|gdarius2.zip" md5="none">
		<interleave output="16">
			<part name="e39-05.3" crc="750e5b13" map="01"/>
			<part name="e39-06.4" crc="2980c30d" map="10"/>
		</interleave>
	</rom>
	<rom index="13"><part>00 00 20 00</part></rom>  <!-- gap: 0x200000 bytes of 00, cleared by the core -->
	<rom index="3" zip="gdariusj.zip|gdarius2.zip" md5="none">
		<part name="e39-01.1" crc="bdaaa251"/>
		<part name="e39-02.2" crc="a47aab5d"/>
		<part name="e39-03.12" crc="a883b6a5"/>
	</rom>

	<!-- Taito Zoom sound board (music): MN10200 program ROM, 512KB,             -->
	<!-- ioctl_index 6 -> DDR3 0x32000000 (MAME "taito_zoom:mn10200" region)     -->
	<rom index="6" zip="gdariusj.zip|gdarius2.zip" md5="none">
		<part name="e39-07.14" crc="2252c7c1"/>
	</rom>

	<!-- Taito Zoom ZSG-2 sample ROM (MAME "taito_zoom:zsg2" region):            -->
	<!-- 4MB, ioctl_index 7 -> DDR3 0x32100000                                   -->
	<rom index="7" zip="gdariusj.zip|gdarius2.zip" md5="none">
		<part name="e39-04.27" crc="6ee35e68"/>
	</rom>


	<!-- CAT702 key A: motherboard key (tt01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000t.zip" md5="none">
		<part name="tt01.ic652" crc="daac13e7"/>
	</rom>

	<!-- CAT702 key B: game key (tt07), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="gdariusj.zip|gdarius2.zip" md5="none">
		<part name="tt07" crc="ccf2f332"/>
	</rom>

	<nvram index="9" size="2048"/>
	<switches default="00">
		<dip name="Service Mode"  bits="1" ids="Off,On"/>
		<dip name="Test Mode"     bits="3" ids="Off,On"/>
	</switches>
	<buttons names="Shot,Capture,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,R,L,Start,Select"/>

</misterromdescription>
