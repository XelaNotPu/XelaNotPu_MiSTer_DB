<misterromdescription>
	<name>Super Football Champ (Ver 2.4O)</name>
	<setname>sfchampo</setname>
	<year>1995</year>
	<manufacturer>Taito</manufacturer>
	<category>Sports</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<rbf>Arcade-XNZN1TaitoFX1A_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- BIOS: Taito FX-1 BIOS, 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1000t.zip" md5="none">
		<part name="m534002c-14.ic353" crc="e3f23b6e"/>
	</rom>

	<!-- Platform: Taito FX (0x02), ioctl_index 1 -->
	<rom index="1">
		<part>12</part>
	</rom>

	<!-- Banked ROM: 2 banks x 8MB = 16MB, ioctl_index 3, CPU 0x1F000000 (8MB window) -->
	<!-- Bank 0: 1MB interleaved + 5MB empty + 2MB e18-02                       -->
	<!-- Bank 1: e18-03 (2MB) + e18-04 (2MB) + e18-05 (2MB) + 2MB empty        -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="sfchampo.zip|sfchamp.zip" md5="none">
		<interleave output="16">
			<part name="e18-08.7" crc="6a5558cd" map="01"/>
			<part name="e18-11.2" crc="f5462f30" map="10"/>
		</interleave>
	</rom>
	<rom index="13"><part>00 00 50 00</part></rom>  <!-- gap: 0x500000 bytes of 00, cleared by the core -->
	<rom index="3" zip="sfchampo.zip|sfchamp.zip" md5="none">
		<part name="e18-02.12" crc="c7b4fe29"/>
		<part name="e18-03.16" crc="76392346"/>
		<part name="e18-04.19" crc="fc3731da"/>
		<part name="e18-05.21" crc="2e984c50"/>
	</rom>
	<rom index="13"><part>00 00 20 00</part></rom>  <!-- gap: 0x200000 bytes of 00, cleared by the core -->

	<!-- CAT702 key A: motherboard key (tt01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000t.zip" md5="none">
		<part name="tt01.ic652" crc="daac13e7"/>
	</rom>

	<!-- CAT702 key B: game key (tt02), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="sfchampo.zip|sfchamp.zip" md5="none">
		<part name="tt02" crc="b1585ac7"/>
	</rom>

	<!-- FX-1A sound: Z80 program (audiocpu), 128KB, ioctl_index 6.
	     Added task #323: without index 6/7 the core keeps the YM2610B sound
	     board disabled (sound_rom_present=0) and music is silent. -->
	<rom index="6" zip="sfchamp.zip" md5="none">
		<part name="e18-09.22" crc="bb5a5319"/>
	</rom>
	<!-- FX-1A sound: YM2610B ADPCM-A samples, 2MB, ioctl_index 7 -->
	<rom index="7" zip="sfchamp.zip" md5="none">
		<part name="e18-01.15" crc="dbd1408c"/>
	</rom>

	<nvram index="9" size="2048"/>
	<switches default="00">
		<dip name="Service Mode"  bits="1" ids="Off,On"/>
		<dip name="Test Mode"     bits="3" ids="Off,On"/>
	</switches>
	<buttons names="Short Pass,Long Pass,Shoot,-,-,-,Start,Coin,Pause" default="A,B,X,Y,R,L,Start,Select"/>

</misterromdescription>
