<misterromdescription>
	<name>Bloody Roar 2 (USA)</name>
	<setname>bldyror2u</setname>
	<year>1998</year>
	<manufacturer>Eighting / Raizing</manufacturer>
	<category>Fighter</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>USA</region>
	<rbf>Arcade-XNZN1Raizing_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- BIOS: Eighting/Raizing ZN-1 BIOS, 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1002e.zip" md5="none">
		<part name="m27c402cz-54.ic353" crc="910f3a8b"/>
	</rom>

	<!-- Platform: Raizing (0x01), ioctl_index 1 -->
	<rom index="1">
		<part>01</part>
	</rom>

	<!-- Banked ROM: 3 banks x 8MB = 24MB, ioctl_index 3, CPU 0x1F000000 (8MB window) -->
	<!-- Bank 0: flash0 (2MB) + flash1 (2MB) + 4MB empty                        -->
	<!-- Bank 1: rom-1a (4MB) + rom-1b (4MB)                                    -->
	<!-- Bank 2: rom-2a (4MB) + rom-2b (4MB)                                    -->
	<!-- Fast loading: the banked ROM (index 3) comes in pieces; each <rom index="13">
	     between them is an empty stretch of the banked image (length, 4 bytes little
	     endian) that the core clears itself instead of receiving zeros. -->
	<rom index="3" zip="bldyror2u.zip|bldyror2.zip" md5="none">
		<part name="flash0.021" crc="fa7602e1"/>
		<part name="flash1.024" crc="03465a69"/>
	</rom>
	<rom index="13"><part>00 00 40 00</part></rom>  <!-- gap: 0x400000 bytes of 00, cleared by the core -->
	<rom index="3" zip="bldyror2u.zip|bldyror2.zip" md5="none">
		<part name="rom-1a.028" crc="0e711461"/>
		<part name="rom-1b.29" crc="0cf153f9"/>
		<part name="rom-2a.026" crc="b71d955d"/>
		<part name="rom-2b.210" crc="89959dde"/>
	</rom>

	<!-- CAT702 key A: motherboard key (et01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1002e.zip" md5="none">
		<part name="et01.ic652" crc="a7dd922e"/>
	</rom>

	<!-- CAT702 key B: game key (et03), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="bldyror2u.zip|bldyror2.zip" md5="none">
		<part name="et03" crc="779b0bfd"/>
	</rom>

	<!-- 68000 sound program, ioctl_index 6 -> SDRAM 0x4400000 (2 x 512KB, byte k = 68000 address k).
	     MAME ROM_LOAD16_BYTE br2_u049 @0 (even), br2_u0412 @1 (odd): map 01 = even byte (68000 D15-D8), map 10 = odd byte. -->
	<rom index="6" zip="bldyror2u.zip|bldyror2.zip" md5="none">
		<interleave output="16">
			<part name="br2_u049.049" crc="10dc855b" map="01"/>
			<part name="br2_u0412.412" crc="e254dd8a" map="10"/>
		</interleave>
	</rom>

	<!-- YMF271 sample ROM ("ymf" region, 4MB), ioctl_index 7 -> SDRAM 0x4000000 -->
	<rom index="7" zip="bldyror2u.zip|bldyror2.zip" md5="none">
		<part name="rom-3.336" crc="b74cc4d1"/>
	</rom>

	<!-- AT28C16 EEPROM preload (RAI signature), ioctl_index 9 - valid content at boot,
	     game validates and skips its fragile blank-EEPROM re-init/verify path -->
	<rom index="9" zip="bldyror2u.zip|bldyror2.zip" md5="none">
		<part name="at28c16_usa" crc="b78d6fc3"/>
	</rom>

	<nvram index="9" size="2048"/>
	<switches default="00">
		<dip name="Service Mode"  bits="1" ids="Off,On"/>
		<dip name="Test Mode"     bits="3" ids="Off,On"/>
	</switches>
	<buttons names="Punch,Kick,Beast,Guard,-,-,Start,Coin,Pause" default="A,B,X,Y,R,L,Start,Select"/>

</misterromdescription>
