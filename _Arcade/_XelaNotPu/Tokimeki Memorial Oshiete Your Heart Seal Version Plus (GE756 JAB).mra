<misterromdescription>
	<name>Tokimeki Memorial Oshiete Your Heart Seal Version Plus (GE756 JAB)</name>
	<setname>tmoshsp</setname>
	<parent>konamigv</parent>
	<year>1997</year>
	<manufacturer>Konami</manufacturer>
	<category>Miscellaneous / Dating Simulation</category>
	<players>1</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>Japan</region>
	<rbf>Arcade-XNKonamiGV_20261119</rbf>
	<mraauthor>XelaNotPu</mraauthor>

	<!-- MAME: "Tokimeki Memorial Oshiete Your Heart Seal Version Plus (GE756 JAB)", set tmoshsp, Konami GV999 board
	     with the sensor / printer board (the version that prints stickers). The core has no heart-rate or skin (GSR) sensor and no
	     printer: it answers as MAME does with its default settings (heart rate "simulated" at
	     80 beats per minute, GSR sensor 0, printer with paper; a print command keeps the
	     printer busy for 1 s, nothing is printed), and it answers the board's device check.
	     The game is on a CD. Convert the MAME disc image games/mame/tmoshsp/756jab01.chd with
	     Scripts > gv_chd_convert: it writes 756jab01.bin (the disc as raw 2352-byte frames,
	     mounted in image slot 0 by the <file> line below) and 756jab01.gvt (+ .gvt.zip), the
	     table of contents (ROM index 10).
	     Controls: joystick and one button (no Start button: Button 1 starts).
	     Needs a MiSTer main program with MRA image mounting (<file>). -->

	<!-- BIOS 999a01.7e, 512 KB, ioctl_index 0 (CPU 0x1FC00000) -->
	<rom index="0" zip="konamigv.zip" md5="none">
		<part name="999a01.7e" crc="ad498d2d"/>
	</rom>

	<!-- Per-set options byte, ioctl_index 1: 0x12 (bit 1: Tokimeki Memorial sensor board;
	     bits 4:3 = 2: Seal Version Plus device check). -->
	<rom index="1">
		<part>12</part>
	</rom>

	<!-- 93C46 EEPROM contents, 128 bytes, ioctl_index 9: the set's default image. It
	     carries the game's identity: the game stops with "25C MBAD" with another one. -->
	<rom index="9" zip="tmoshsp.zip" md5="none">
		<part name="tmoshsp.25c" crc="af4cdd87"/>
	</rom>

	<!-- Disc table of contents (2048 bytes), ioctl_index 10, read from the games/mame folder -->
	<rom index="10" zip="tmoshsp/756jab01.gvt.zip" md5="none">
		<part name="756jab01.gvt"/>
	</rom>

	<!-- Disc: raw 2352-byte-frame image in image slot 0 -->
	<file delay="0" type="s" index="0" root="games" path="mame/tmoshsp/756jab01.bin"/>

	<buttons names="Button 1,-,-,-,-,-,-,Coin,Pause,Service,Test" default="A,B,X,R,L,Y,Start,Select" count="1"/>

	<!-- 93C46 EEPROM (settings): saved by MiSTer to config/nvram/<name>.nvm -->
	<nvram index="9" size="128"/>
</misterromdescription>
